{
  "$defs": {
    "IngestRecord": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "description": "ServiceNow alan adlarıyla öznitelikler",
          "title": "Attributes",
          "type": "object"
        },
        "class_hint": {
          "description": "Önerilen ServiceNow sınıfı (ör. cmdb_ci_linux_server)",
          "pattern": "^[a-z][a-z0-9_]{1,79}$",
          "title": "Class Hint",
          "type": "string"
        },
        "data_source": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,63}$",
          "title": "Data Source",
          "type": "string"
        },
        "deleted": {
          "default": false,
          "description": "Kaynak nesnenin silindiğini açıkça bildirir (delta modu)",
          "title": "Deleted",
          "type": "boolean"
        },
        "external_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "External Ids",
          "type": "object"
        },
        "lookup": {
          "$ref": "#/$defs/LookupData"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "raw_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ham yükün arşivdeki konumu",
          "title": "Raw Ref"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationRef"
          },
          "maxItems": 512,
          "title": "Relations",
          "type": "array"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_key": {
          "description": "Kaynaktaki kalıcı nesne kimliği",
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        }
      },
      "required": [
        "data_source",
        "run_id",
        "source_key",
        "class_hint",
        "observed_at"
      ],
      "title": "IngestRecord",
      "type": "object"
    },
    "LookupData": {
      "additionalProperties": false,
      "description": "IRE *lookup* karşılığı: bir CI'ın çoklu tanımlayıcıları.",
      "properties": {
        "ip_addresses": {
          "items": {
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Ip Addresses",
          "type": "array"
        },
        "mac_addresses": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Mac Addresses",
          "type": "array"
        },
        "serial_numbers": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Serial Numbers",
          "type": "array"
        }
      },
      "title": "LookupData",
      "type": "object"
    },
    "RelationRef": {
      "additionalProperties": false,
      "description": "Aynı veya başka bir kaynaktaki nesneye ilişki (ör. VM → ESXi host).",
      "properties": {
        "direction": {
          "description": "Bu kaydın ilişkideki rolü. 'parent': bu kayıt → hedef (ör. uygulama 'Runs on' sunucu).",
          "enum": [
            "parent",
            "child"
          ],
          "title": "Direction",
          "type": "string"
        },
        "target_class_hint": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Class Hint"
        },
        "target_data_source": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Data Source"
        },
        "target_source_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Target Source Key",
          "type": "string"
        },
        "type": {
          "examples": [
            "Runs on::Runs",
            "Virtualized by::Virtualizes"
          ],
          "pattern": "^[^:]+::[^:]+$",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "direction",
        "target_source_key"
      ],
      "title": "RelationRef",
      "type": "object"
    }
  },
  "$id": "urn:evren:schema:IngestEnvelope:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/IngestRecord"
    },
    "datacontenttype": {
      "const": "application/json",
      "default": "application/json",
      "title": "Datacontenttype",
      "type": "string"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "source": {
      "examples": [
        "urn:evren:connector:zabbix:dc1"
      ],
      "maxLength": 512,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "specversion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Specversion",
      "type": "string"
    },
    "subject": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "time": {
      "format": "date-time",
      "title": "Time",
      "type": "string"
    },
    "type": {
      "const": "evren.ingest.record.v1",
      "default": "evren.ingest.record.v1",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source",
    "time",
    "data"
  ],
  "title": "IngestEnvelope",
  "type": "object"
}
